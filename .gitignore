# Public repository allowlist. Everything else stays local by default.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/requirements-baselines.txt
!/Dockerfile
!/.dockerignore
!/compose.yaml
!/compose.gpu.yaml
!/crackdl/

/crackdl/*
!/crackdl/aggregate.py
!/crackdl/bench.py
!/crackdl/data.py
!/crackdl/docker_smoke.py
!/crackdl/models_cnn.py
!/crackdl/models_ssl.py
!/crackdl/models_ssm.py
!/crackdl/models_transformer.py
!/crackdl/prep.py
!/crackdl/registry.py
!/crackdl/roastformer.py
!/crackdl/run_all.py
!/crackdl/smoke.py
!/crackdl/stats.py
!/crackdl/train.py

# Never publish credentials, private documents, or generated artifacts.
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*confidential*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.kdbx
**/__pycache__/
**/*.pyc
**/cache/
**/ckpt/
**/results/
**/*.log
/paper/
/resti/
/commit-template/
/latex-template/
/coffee-roasting-acoustic-dataset/
/output/
/tmp/
/.playwright-mcp/
**/*.pdf
**/*.docx
**/*.doc
**/*.tex
**/*.zip
